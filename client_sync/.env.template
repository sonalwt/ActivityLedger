# ActivityWatch Sync Client Configuration
# Copy this file to .env and fill in your values

# Server Configuration
SERVER_URL=https://api-timesheet.firsteconomy.com/api/sync
# or for local testing: SERVER_URL=http://localhost:8000/api/sync

# Developer Identity (Get these from your admin or developer-setup page)
DEVELOPER_ID=your-name-here
API_TOKEN=your-api-token-from-registration

# Local ActivityWatch Configuration (usually don't need to change)
ACTIVITYWATCH_HOST=http://localhost:5600

# Sync Settings
SYNC_INTERVAL_MINUTES=5
LOG_LEVEL=INFO
