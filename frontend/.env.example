# Environment variables for the React application
# Copy this file to .env.local for local development

# API Base URL - Backend server URL
REACT_APP_API_URL=http://localhost:8000

# Environment mode
ENVIRONMENT=local

# ActivityWatch API URL
REACT_APP_AW_API_URL=http://localhost:5600/api/0

# Developer mode flag
REACT_APP_LOCAL_DEVELOPER_MODE=true
