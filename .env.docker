# Docker Compose Environment Configuration
# Copy this file to .env before running: docker compose up -d

# ── Ports (change if these conflict with other services) ──
FRONTEND_PORT=3080
BACKEND_PORT=8080

# ── Database (internal to Docker, no host port exposed) ──
POSTGRES_DB=timesheet
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password-here

# ── Backend ──
SECRET_KEY=generate-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENVIRONMENT=production
ACTIVITYWATCH_HOST=http://localhost:5600
MASTER_SECRET=your-master-secret

# ── Domain (replace with your actual domain) ──
SERVER_URL=https://timesheet.yourdomain.com
Frontend_URL=https://timesheet.yourdomain.com
PRODUCTION_DOMAIN=timesheet.yourdomain.com

# ── Frontend ──
# Leave empty — nginx proxies /api/ to backend internally
REACT_APP_API_URL=
