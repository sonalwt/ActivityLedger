# Backend Environment Configuration
# Copy this file to .env.local for local development

# Environment: local or production
ENVIRONMENT=local

# Database Configuration
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/timesheet

# JWT Authentication
SECRET_KEY=generate-a-random-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ActivityWatch Configuration
ACTIVITYWATCH_HOST=http://localhost:5600

# Developer Identity
LOCAL_DEVELOPER_NAME=Your-Name

# Network Discovery (set to true in production)
ENABLE_NETWORK_DISCOVERY=false
DISCOVERY_CACHE_HOURS=1

# Production Settings (only needed in production)
# PRODUCTION_DOMAIN=your-domain.com
# PRODUCTION_DATABASE_URL=postgresql://user:pass@host:5432/timesheet
# MASTER_SECRET=your-master-secret
# SERVER_URL=https://your-api-domain.com
# Frontend_URL=https://your-frontend-domain.com
